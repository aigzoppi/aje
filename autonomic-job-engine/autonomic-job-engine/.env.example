# Copy to .env and adjust. All engine settings use the AJE_ prefix.
RABBITMQ_USER=aje
RABBITMQ_PASSWORD=aje
POSTGRES_USER=aje
POSTGRES_PASSWORD=aje

# local | kubernetes
AJE_BACKEND=local
# protect the API (sent as X-API-Key); empty = no auth
AJE_API_KEY=
AJE_MONITOR_INTERVAL=5
AJE_MONITOR_WINDOW=60
AJE_LOG_LEVEL=INFO
# connections in the engine's PostgreSQL (asyncpg) pool
AJE_DB_POOL_SIZE=10

# kubernetes mode only
AJE_K8S_NAMESPACE=aje-jobs
AJE_WORKER_AMQP_URL=amqp://aje:aje@host.docker.internal:5672/
AJE_WORKER_IMAGE=aje-worker:latest
KUBECONFIG_PATH=~/.kube/config
