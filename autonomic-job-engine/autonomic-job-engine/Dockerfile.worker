# Base image for workers running on Kubernetes.
# Contains only the worker SDK (aje_worker) and its dependencies
# (aio-pika, msgpack, pydantic, psycopg for the PostgreSQL data plane).
#
# Layout:  /app/ajeworker/aje_worker   the SDK (from src/aje_worker)
#          /app/ajeworker/...          your handlers (PYTHONPATH=/app/ajeworker)
#
# Use it as is with the bundled examples:
#   command: ["python", "-m", "aje_worker", "aje_worker.examples:square"]
# or extend it with your own handler:
#   FROM aje-worker:latest
#   COPY my_handlers.py /app/ajeworker/
#   # command: ["python", "-m", "aje_worker", "my_handlers:process"]
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/ajeworker \
    UV_NO_CACHE=1 \
    UV_COMPILE_BYTECODE=1

RUN apt-get -y update \
 && apt-get -y upgrade \
 && apt-get -y clean \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv

WORKDIR /app/ajeworker
# keep in sync with [project.optional-dependencies] worker in pyproject.toml
RUN uv pip install --system "aio-pika>=9.4" "msgpack>=1.0" "pydantic>=2.6" "psycopg[binary]>=3.2"
COPY src/aje_worker ./aje_worker
RUN useradd --uid 10001 --home-dir /home/worker --create-home worker
USER 10001

# SIGTERM -> finish current task (grace AJE_TERM_GRACE) -> exit 143 (not a Job success)
# drain broadcast -> finish current task -> exit 0 (Job completes)
CMD ["python", "-m", "aje_worker", "aje_worker.examples:square"]
